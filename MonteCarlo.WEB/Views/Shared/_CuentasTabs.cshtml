@*
    Pestanas de cuentas de administrador (HU-AUT-007): Cuentas e Historial de cambios.
    Todo el modulo es solo para el Administrador General (la API y los controladores lo exigen tambien).

    Uso:
        <partial name="_CuentasTabs" model='"cuentas"' />
    El modelo es la pestana activa: "cuentas" o "historial".
*@
@model string

<nav class="mc-tabs" aria-label="Secciones de cuentas de administrador">
    <a class="mc-tab @(Model == "cuentas" ? "is-active" : null)"
       asp-area="Admin" asp-controller="Usuarios" asp-action="Index"
       aria-current="@(Model == "cuentas" ? "page" : null)">Cuentas</a>

    <a class="mc-tab @(Model == "historial" ? "is-active" : null)"
       asp-area="Admin" asp-controller="HistorialUsuarios" asp-action="Index"
       aria-current="@(Model == "historial" ? "page" : null)">Historial de cambios</a>
</nav>
