@*
    Caja de pedido (HU-CON-002): modal grande para agregar pedidos a una cuenta de mesa. Llega por fetch desde
    GET admin/ventas/cuenta/{idReserva}/caja y site.js ([data-mc-caja]) la monta y la quita al cerrarse.
    El menu y el ticket son el parcial _Caja, que comparte con la venta para llevar (HU-CON-003).
*@
@using MonteCarlo.WEB.Models.Ventas
@model CajaViewModel
@{
    var c = Model.Cuenta;
    var invariante = System.Globalization.CultureInfo.InvariantCulture;
    // Lineas activas (la mas reciente primero): la caja las edita igual que el pedido nuevo y al guardar anula las que se quitaron.
    var lineasJson = LineaActivaJson.Serializar(c.LineasActivas());
}
<div class="modal fade mc-caja" id="mcCajaModal" tabindex="-1" aria-labelledby="mcCajaTitulo" aria-hidden="true"
     data-mc-caja
     data-id-reserva="@c.IdReserva"
     data-mesa="@Model.EtiquetaMesa"
     data-cuenta-total="@c.Total.ToString(invariante)"
     data-lineas="@lineasJson">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="mcCajaTitulo">Agregar pedido · @Model.EtiquetaMesa</h2>
                    <p class="mc-caja__sub">@c.Cliente · @c.Personas @(c.Personas == 1 ? "persona" : "personas")</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body mc-caja__cuerpo">
                <partial name="_Caja" model="Model" />
            </div>

            <div class="modal-footer">
                <span class="mc-caja__resumen" data-mc-caja-resumen></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-mc-caja-confirmar disabled>Agregar a la cuenta</button>
            </div>
        </div>
    </div>
</div>
