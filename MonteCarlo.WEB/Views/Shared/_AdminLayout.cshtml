@*
    Layout ADMINISTRATIVO — todo el area Admin tras iniciar sesion.

    Composicion:
      _AdminSidebar   navegacion por modulo
      _AdminTopbar    identidad, Mi Cuenta y cierre de sesion
      _Alerts         mensajes de TempData
      _ConfirmModal   dialogo de confirmacion compartido

    Cada vista define:
      ViewData["Title"]      titulo de la pestana y encabezado
      ViewData["Subtitle"]   bajada opcional bajo el titulo
      ViewData["Icon"]       clase de Bootstrap Icons (ej. "bi-cup-hot") para el recuadro de identidad (opcional)
      section PageActions    accion(es) principal(es), a la derecha del titulo (opcional)
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Monte Carlo</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="mc-skip-link" href="#contenido">Saltar al contenido principal</a>

    <div class="mc-admin">
        <partial name="_AdminSidebar" />
        <div class="mc-backdrop" data-mc-sidebar-backdrop></div>

        <div class="mc-admin__main">
            <partial name="_AdminTopbar" />

            <main id="contenido" class="mc-admin__content">
                @* Encabezado de pagina comun a todas las pantallas del area Admin. *@
                <header class="mc-pagehead">
                    <div class="mc-pagehead__top">
                        @if (ViewData["Icon"] is string icono && !string.IsNullOrWhiteSpace(icono))
                        {
                            <span class="mc-pagehead__icono" aria-hidden="true"><i class="bi @icono"></i></span>
                        }
                        <div class="mc-pagehead__titulo">
                            <h1>@ViewData["Title"]</h1>
                            @if (ViewData["Subtitle"] is string subtitle && !string.IsNullOrWhiteSpace(subtitle))
                            {
                                <p>@subtitle</p>
                            }
                        </div>

                        @if (IsSectionDefined("PageActions"))
                        {
                            <div class="mc-pagehead__accion">
                                @await RenderSectionAsync("PageActions", required: false)
                            </div>
                        }
                    </div>

                </header>

                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
