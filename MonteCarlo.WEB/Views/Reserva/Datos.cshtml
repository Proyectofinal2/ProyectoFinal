@using MonteCarlo.WEB.Models.Reservas
@model DatosReservaViewModel

@{
    ViewData["Title"] = "Datos de la reserva";
    ViewData["Description"] = "Completa tus datos para confirmar la reserva en Mirador Monte Carlo.";
    var cultura = new System.Globalization.CultureInfo("es-CR");
}

<section class="mc-reservation">

    <ol class="mc-reservation__steps" aria-label="Progreso de la reserva">
        <li class="mc-reservation__step is-done">
            <span class="mc-reservation__step-number">✓</span>
            <span>Fecha y hora</span>
        </li>
        <li class="mc-reservation__step is-current" aria-current="step">
            <span class="mc-reservation__step-number">2</span>
            <span>Datos</span>
        </li>
        <li class="mc-reservation__step">
            <span class="mc-reservation__step-number">3</span>
            <span>Confirmación</span>
        </li>
    </ol>

    <div class="mc-reservation__heading">
        <span class="mc-eyebrow">Nueva reserva</span>
        <h1 class="mc-reservation__title">Sus datos de contacto</h1>
        <p class="mc-reservation__lead">
            Los usaremos para confirmar la reserva y avisarle ante cualquier cambio.
        </p>
    </div>

    <div class="row g-4 align-items-start">

        <!-- Formulario -->
        <div class="col-12 col-lg-7">
            <article class="mc-reservation__card">
                <form asp-action="Datos" method="post" novalidate>

                    @* Campos ocultos del paso 1 *@
                    <input type="hidden" asp-for="FechaReserva" />
                    <input type="hidden" asp-for="HoraReserva" />
                    <input type="hidden" asp-for="CantidadPersonas" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Nombre" class="form-label mc-required"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Andrea" autofocus />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-control" placeholder="Ej. Salas" />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Telefono" class="form-label mc-required"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej. 8888-1234" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CorreoElectronico" class="form-label"></label>
                            <input asp-for="CorreoElectronico" class="form-control" placeholder="nombre@correo.com" />
                            <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                            <div class="form-text">Si lo indica, también recibirá la confirmación por este medio.</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label"></label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3"
                                      placeholder="Ej. Celebración de cumpleaños, silla para bebé, etc."></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Create" class="link-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Confirmar reserva
                            <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </form>
            </article>
        </div>

        <!-- Resumen lateral -->
        <div class="col-12 col-lg-5">
            <article class="mc-reservation__card mc-reservation__card--summary">
                <h2 class="mc-reservation__card-title">Resumen</h2>

                <div class="mc-summary-row">
                    <span>Fecha</span>
                    <span>@Model.FechaReserva.ToString("dddd d 'de' MMMM", cultura)</span>
                </div>
                <div class="mc-summary-row">
                    <span>Hora</span>
                    <span>@Model.HoraReserva.ToString("HH:mm")</span>
                </div>
                <div class="mc-summary-row">
                    <span>Personas</span>
                    <span>@Model.CantidadPersonas</span>
                </div>

                <a asp-action="Create" class="mc-summary-edit">Cambiar fecha u hora</a>
            </article>
        </div>

    </div>
</section>

@section Styles {
    <style>
        .mc-summary-row {
            display: flex;
            justify-content: space-between;
            font-size: var(--mc-text-sm);
            padding: var(--mc-space-2) 0;
            border-bottom: 1px solid var(--mc-border);
        }
        .mc-summary-row:last-of-type { border-bottom: none; }
        .mc-summary-row span:first-child { color: var(--mc-ink-muted); }
        .mc-summary-row span:last-child { font-weight: var(--mc-weight-semibold); }

        .mc-summary-edit {
            display: inline-block;
            margin-top: var(--mc-space-4);
            font-size: var(--mc-text-sm);
            font-weight: var(--mc-weight-semibold);
            color: var(--mc-copper-700);
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        .mc-reservation__card--summary {
            background: var(--mc-green-50);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}