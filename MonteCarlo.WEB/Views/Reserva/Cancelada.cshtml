@using MonteCarlo.WEB.Models.Reservas
@model ReservaApiResponse

@{
    ViewData["Title"] = "Reserva cancelada";
    ViewData["Description"] = "Tu reserva fue cancelada exitosamente.";
    var cultura = new System.Globalization.CultureInfo("es-CR");
}

<section class="container py-5" style="max-width: 560px;">
    <div class="card text-center">
        <div class="card-body p-4 p-md-5">
            <div class="mc-cancelada__check" aria-hidden="true">
                <i class="bi bi-x-circle"></i>
            </div>

            <span class="mc-eyebrow">Reserva cancelada</span>
            <h1 class="h3 mb-2">Tu reserva fue cancelada</h1>
            <p class="text-muted mb-4">
                La mesa quedó liberada y ya no podrá utilizarse con este código.
            </p>

            <div class="mc-cancelada__code">
                <div class="small text-muted">Código de reserva</div>
                <div class="fs-4 fw-semibold">@Model.CodigoReserva</div>
            </div>

            <dl class="row text-start mb-4">
                <dt class="col-5 text-muted">Cliente</dt>
                <dd class="col-7">@Model.NombreCliente</dd>

                <dt class="col-5 text-muted">Fecha</dt>
                <dd class="col-7">@Model.FechaReserva.ToString("dddd d 'de' MMMM 'de' yyyy", cultura)</dd>

                <dt class="col-5 text-muted">Hora</dt>
                <dd class="col-7">@Model.HoraReserva.ToString("HH:mm")</dd>

                <dt class="col-5 text-muted">Personas</dt>
                <dd class="col-7">@Model.CantidadPersonas</dd>
            </dl>

            <div class="d-grid gap-2">
                <a asp-controller="Reserva" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-calendar-plus me-2"></i>Hacer otra reserva
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Volver al inicio
                </a>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .mc-cancelada__check {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--mc-danger-bg);
            color: var(--mc-danger);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--mc-space-4);
            font-size: 1.75rem;
        }

        .mc-cancelada__code {
            background: var(--mc-surface);
            border: 1px dashed var(--mc-border-strong);
            border-radius: var(--mc-radius);
            padding: var(--mc-space-3) var(--mc-space-4);
            margin-bottom: var(--mc-space-4);
        }

        .mc-eyebrow {
            display: block;
            font-size: var(--mc-text-xs);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--mc-ink-subtle);
            font-weight: var(--mc-weight-semibold);
            margin-bottom: var(--mc-space-2);
        }
    </style>
}