@using MonteCarlo.WEB.Models.Configuracion
@model MetodosPagoViewModel
@{
    ViewData["Title"] = "Métodos de Pago";
    ViewData["Subtitle"] = "Administra las opciones de cobro disponibles.";
}

<partial name="_MetodosPagoTabs" model='"administrar"' />

<div class="row g-4">
    <!-- Formulario de Creación -->
    <div class="col-12 col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Nuevo Método de Pago</h5>
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="nombre" class="form-control" placeholder="Ej. Transferencia Bancaria" required maxlength="30" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i> Registrar
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Lista de Métodos -->
    <div class="col-12 col-md-8">
        <div class="mc-table-card">
            <table class="table mc-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Método</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Metodos.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No hay métodos de pago registrados.</td>
                        </tr>
                    }
                    @foreach (var m in Model.Metodos)
                    {
                        <tr>
                            <td class="fw-medium">@m.Nombre</td>
                            <td>
                                @if (m.Activo)
                                {
                                    <span class="badge text-bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">No disponible</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.IdMetodoPago" />

                                    @if (m.Activo)
                                    {
                                        <!-- Si está activo, enviamos false para deshabilitarlo -->
                                        <input type="hidden" name="activo" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deshabilitar</button>
                                    }
                                    else
                                    {
                                        <!-- Si NO está activo, enviamos true para habilitarlo -->
                                        <input type="hidden" name="activo" value="true" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Habilitar</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
