@*
    HU-CFG-002 — Días fijos de cierre semanal.

    Escenario 1  marcar uno o más días y confirmar: se cierran de forma recurrente
                 y se registra en el historial de auditoría.
    Escenario 2  desmarcar un día y confirmar: deja de aplicarse desde ahora;
                 no afecta reservas confirmadas ni cierres eventuales.
*@
@using MonteCarlo.WEB.Models.Configuracion
@model CierresFijosViewModel
@{
    ViewData["Title"] = "Cierres";
    ViewData["Subtitle"] = "Dias de la semana en que el restaurante permanece cerrado.";
}

<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Index" method="post" data-mc-guard-submit>
                    <fieldset class="mb-3">
                        <legend class="fs-6 fw-semibold">Cierres fijos semanales</legend>

                        @foreach (var (valor, nombre) in CierresFijosViewModel.DiasSemana)
                        {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="dia-@valor" name="Dias" value="@valor"
                                   checked="@Model.Dias.Contains(valor)" />
                            <label class="form-check-label" for="dia-@valor">@nombre</label>
                        </div>
                        }

                        <div class="form-text mt-2">
                            Los dias marcados no se ofreceran en el calendario de reservas, cada semana.
                            Desmarcar un dia no afecta reservas ya confirmadas ni cierres eventuales.
                        </div>
                    </fieldset>

                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8 col-xl-6 mt-4 mt-lg-0">
        <div class="card">
            <div class="card-body">
                <h2 class="fs-6 fw-semibold">Cierres eventuales</h2>

                <form asp-action="RegistrarEventual" method="post" data-mc-guard-submit>
                    <div class="mb-3">
                        <label for="fecha-eventual" class="form-label mc-required">Fecha a cerrar</label>
                        <input id="fecha-eventual" name="Fecha" type="date" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="motivo-eventual" class="form-label mc-required">Motivo</label>
                        <input id="motivo-eventual" name="Motivo" class="form-control" maxlength="300" required />
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="cancelar-reservas"
                               name="CancelarReservas" value="true" />
                        <label class="form-check-label" for="cancelar-reservas">
                            Cancelar las reservas que existan en esa fecha
                        </label>
                        <div class="form-text">
                            Si hay reservas y no se marca esta opcion, el cierre no se registra.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Registrar cierre</button>
                </form>
            </div>
        </div>

        @if (Model.Eventuales.Count > 0)
        {
            <div class="mc-table-card mt-4">
                <div class="table-responsive">
                    <table class="table mc-table align-middle mb-0">
                        <caption class="visually-hidden">Cierres eventuales proximos</caption>
                        <thead>
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Motivo</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cierre in Model.Eventuales)
                            {
                                <tr>
                                    <td class="text-nowrap fw-medium">@cierre.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@cierre.Motivo</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-ghost-danger"
                                                data-mc-confirm
                                                data-mc-confirm-title="Quitar cierre"
                                                data-mc-confirm-body="@($"La fecha {cierre.Fecha:dd/MM/yyyy} volvera a estar disponible para reservas. Las reservas que ya se cancelaron por este cierre no se restablecen.")"
                                                data-mc-confirm-action="@Url.Action(nameof(CierresController.EliminarEventual), new { id = cierre.IdCierreEventual })"
                                                data-mc-confirm-label="Quitar cierre"
                                                data-mc-confirm-variant="danger">
                                            Quitar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
