@*
    Reservas.

    HU-OPE-005: busqueda por nombre o telefono. El filtro de fechas y el de
    busqueda funcionan de forma independiente:
    - Sin busqueda: muestra las reservas del rango seleccionado (por defecto, hoy).
    - Con busqueda: muestra coincidencias en TODAS las fechas futuras.
    El filtro de origen (con reserva / walk-in) y la paginacion de 10 filas se aplican sobre ese resultado.

    HU-OPE-003: registrar llegada (Cliente llegó) y marcar No Show.
    HU-CON-002: consumo de la reserva y cuenta de mesa (cajón); las ventas cobradas se consultan en Ventas.
    HU-OPE-002: cancelar reservas Confirmadas o Pendientes.

    Acciones: tres columnas fijas por fila (boton principal, No Show y Cancelar como botones de icono), siempre alineadas.
*@
@using MonteCarlo.WEB.Models.Reservas
@using MonteCarlo.WEB.Models.Ventas
@using MonteCarlo.WEB.Models.UI
@model ReservasDelDiaViewModel
@{
    ViewData["Title"] = "Reservas";
    ViewData["Subtitle"] = "Planifica la operación y prepara la atención.";
    ViewData["Icon"] = "bi-calendar-check";
    var mostrarFecha = Model.ModoBusqueda || Model.EsRango;
    var fechaDesde = Model.Desde.ToString("yyyy-MM-dd");
    var fechaHasta = Model.Hasta.ToString("yyyy-MM-dd");
    var hoy = DateOnly.FromDateTime(DateTime.Now);
    var hayFiltroTipo = Model.Tipo != "";

    // Parametros que conservan los enlaces del filtro de origen y de la paginacion.
    var parametros = new Dictionary<string, string?>
    {
        ["desde"] = Model.ModoBusqueda ? null : fechaDesde,
        ["hasta"] = Model.ModoBusqueda ? null : fechaHasta,
        ["buscar"] = Model.TerminoBusqueda,
        ["tipo"] = Model.Tipo == "" ? null : Model.Tipo
    };
}

@functions {
    private static string Duracion(int minutos) =>
        minutos < 1440 ? CuentaViewModel.Duracion(minutos) : "más de un día";
}

<!-- Token de seguridad necesario para el POST manual -->
@Html.AntiForgeryToken()

<!-- Indicadores del rango (no cambian con el filtro de origen) -->
<section class="mc-stats" aria-label="Resumen de reservas">
    <div class="mc-stat">
        <span class="mc-stat__icono" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
        <div>
            <span class="mc-stat__valor">@Model.Reservas.Count</span>
            <span class="mc-stat__etiqueta">@(Model.ModoBusqueda ? "Coincidencias" : Model.EsRango ? "Reservas del rango" : "Reservas del día")</span>
        </div>
    </div>
    <div class="mc-stat">
        <span class="mc-stat__icono mc-stat__icono--info" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
        <div>
            <span class="mc-stat__valor">@Model.Atendidas</span>
            <span class="mc-stat__etiqueta">Atendidas</span>
        </div>
    </div>
    <div class="mc-stat">
        <span class="mc-stat__icono" aria-hidden="true"><i class="bi bi-clock"></i></span>
        <div>
            <span class="mc-stat__valor">@Model.Proximas</span>
            <span class="mc-stat__etiqueta">Próximas</span>
        </div>
    </div>
    <div class="mc-stat">
        <span class="mc-stat__icono mc-stat__icono--warning" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
        <div>
            <span class="mc-stat__valor">@Model.ConRetraso</span>
            <span class="mc-stat__etiqueta">Con retraso</span>
        </div>
    </div>
</section>

<!-- Filtros por GET: rango de fechas (se aplica al cambiarlo), atajos, busqueda con Enter y origen -->
<div class="mc-toolbar">
    <form id="filtros-reservas" asp-action="Index" method="get" role="search" class="mc-toolbar__fila">
        <div class="mc-rango @(Model.ModoBusqueda ? "is-disabled" : null)" role="group" aria-label="Rango de fechas">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <label for="desde" class="visually-hidden">Desde</label>
            <input id="desde" name="desde" type="date" class="mc-rango__input" value="@fechaDesde" data-mc-autosubmit
                   @(Model.ModoBusqueda ? "disabled" : null) />
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
            <label for="hasta" class="visually-hidden">Hasta</label>
            <input id="hasta" name="hasta" type="date" class="mc-rango__input" value="@fechaHasta" min="@fechaDesde" data-mc-autosubmit
                   @(Model.ModoBusqueda ? "disabled" : null) />
        </div>

        <div class="mc-chips" role="group" aria-label="Atajos de fecha">
            @foreach (var (texto, d, h) in new[] { ("Hoy", hoy, hoy), ("Mañana", hoy.AddDays(1), hoy.AddDays(1)), ("Próximos 7 días", hoy, hoy.AddDays(6)) })
            {
                var activo = !Model.ModoBusqueda && Model.Desde == d && Model.Hasta == h;
                <a class="mc-preset @(activo ? "is-active" : null)" asp-action="Index"
                   asp-route-desde="@d.ToString("yyyy-MM-dd")" asp-route-hasta="@h.ToString("yyyy-MM-dd")"
                   asp-route-tipo="@(Model.Tipo == "" ? null : Model.Tipo)"
                   aria-current="@(activo ? "true" : null)">@texto</a>
            }
        </div>

        <div class="mc-search mc-search--fin">
            <i class="bi bi-search mc-search__icono" aria-hidden="true"></i>
            <label for="buscar" class="visually-hidden">Buscar por nombre o teléfono</label>
            <input id="buscar" name="buscar" type="search" class="mc-search__input" value="@Model.TerminoBusqueda"
                   placeholder="Buscar por nombre o teléfono" maxlength="100" autocomplete="off" />
        </div>
        <button type="submit" class="visually-hidden">Buscar</button>
        @if (hayFiltroTipo)
        {
            <input type="hidden" name="tipo" value="@Model.Tipo" />
        }
    </form>

    <div class="mc-toolbar__fila">
        <nav class="mc-segment" aria-label="Origen de la reserva">
            @foreach (var (valor, texto, conteo) in new[] { ("", "Todas", Model.Reservas.Count), ("reserva", "Con reserva", Model.ConReserva), ("walkin", "Walk-in", Model.WalkIn) })
            {
                var activo = Model.Tipo == valor;
                <a class="mc-segment__op @(activo ? "is-active" : null)"
                   asp-action="Index"
                   asp-route-desde="@parametros["desde"]" asp-route-hasta="@parametros["hasta"]"
                   asp-route-buscar="@Model.TerminoBusqueda"
                   asp-route-tipo="@(valor == "" ? null : valor)"
                   aria-current="@(activo ? "true" : null)">@texto<span class="mc-segment__conteo">@conteo</span></a>
            }
        </nav>
        @if (Model.ModoBusqueda || hayFiltroTipo || Model.Desde != hoy || Model.Hasta != hoy)
        {
            <a asp-action="Index" class="mc-toolbar__limpiar"><i class="bi bi-x-lg" aria-hidden="true"></i> Restablecer a hoy</a>
        }
    </div>
</div>

@if (Model.ModoBusqueda)
{
    <p class="form-text mb-3" role="status">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        Resultados de <strong>"@Model.TerminoBusqueda"</strong> en todas las fechas; el rango se ignora mientras buscas.
    </p>
}

@if (Model.Filtradas.Count == 0)
{
    <div class="mc-table-card">
        <partial name="_EstadoVacio" model="@(new EstadoVacioViewModel
                 {
                     Icono = Model.ModoBusqueda ? "bi-search" : "bi-calendar-check",
                     Titulo = Model.ModoBusqueda ? "No se encontraron coincidencias"
                         : hayFiltroTipo ? "No hay reservas de este tipo"
                         : Model.EsRango ? "No hay reservas en este rango" : "No hay reservas para este día",
                     Descripcion = Model.ModoBusqueda ? $"Ninguna reserva coincide con \"{Model.TerminoBusqueda}\"."
                         : hayFiltroTipo ? "Prueba con otro filtro de origen."
                         : "Cuando haya reservas para estas fechas aparecerán aquí."
                 })" />
    </div>
}
else
{
    <div class="mc-table-card">
        <div class="table-responsive">
            <table class="table mc-table mc-reservas align-middle">
                <caption class="visually-hidden">
                    Reservas @(Model.ModoBusqueda ? "encontradas por búsqueda" : "ordenadas por fecha y hora")
                </caption>
                <thead>
                    <tr>
                        <th scope="col">@(mostrarFecha ? "Fecha y hora" : "Hora")</th>
                        <th scope="col">Cliente</th>
                        <th scope="col" class="text-center">Personas</th>
                        <th scope="col">Mesa</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Consumo</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reserva in Model.PaginaActual)
                    {
                        var nombre = reserva.EsWalkIn ? "Walk-in" : reserva.NombreCliente;
                        var consumo = reserva.Consumo;
                        var puedeLlegar = reserva.Estado == "Confirmada" && !reserva.EnProgreso && reserva.FechaReserva == hoy;
                        var puedeNoShow = reserva.Estado == "Confirmada" && !reserva.EnProgreso && reserva.FechaReserva <= hoy;
                        var puedeCancelar = reserva.Estado is "Confirmada" or "Pendiente" && !reserva.EnProgreso;
                        var claseFila = reserva.MinutosExcedidos is not null ? "mc-fila--exceso" : reserva.MinutosDeRetraso is not null ? "mc-fila--retraso" : null;

                        <tr class="@claseFila">
                            <!-- Hora (y fecha si el rango abarca varios dias) -->
                            <td class="mc-num">
                                <span class="mc-reservas__hora">@reserva.HoraReserva.ToString("HH:mm")</span>
                                @if (mostrarFecha)
                                {
                                    <span class="mc-reservas__sub">@reserva.FechaReserva.ToString("dd/MM/yyyy")</span>
                                }
                            </td>

                            <!-- Cliente -->
                            <td>
                                <span class="fw-medium">@nombre</span>
                                @if (reserva.EsWalkIn)
                                {
                                    <span class="mc-reservas__sub">Sin reserva previa</span>
                                }
                                else
                                {
                                    <span class="mc-reservas__sub">
                                        @reserva.Telefono@(string.IsNullOrWhiteSpace(reserva.Telefono) || string.IsNullOrWhiteSpace(reserva.CodigoReserva) ? "" : " · ")@reserva.CodigoReserva
                                    </span>
                                }
                                @if (reserva.EnProgreso)
                                {
                                    <span class="mc-reservas__sub text-success"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Llegó a las @reserva.FechaAtencion!.Value.ToString("HH:mm")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(reserva.Observaciones))
                                {
                                    <span class="mc-reservas__sub mc-reservas__obs" title="@reserva.Observaciones">
                                        <i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@reserva.Observaciones
                                    </span>
                                }
                            </td>

                            <td class="text-center mc-num">@reserva.CantidadPersonas</td>

                            <!-- Mesa -->
                            <td class="text-nowrap">
                                @if (reserva.NumerosMesa.Count > 0)
                                {
                                    <span>Mesa @string.Join(" + ", reserva.NumerosMesa)</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Sin mesa</span>
                                }
                            </td>

                            <!-- Estado e indicadores de tiempo -->
                            <td>
                                @if (reserva.EnProgreso)
                                {
                                    <span class="mc-badge mc-badge--info"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>En progreso</span>
                                }
                                else
                                {
                                    <partial name="_BadgeEstado" model="BadgeEstadoViewModel.Reserva(reserva.Estado)" />
                                }
                                @if (reserva.MinutosDeRetraso is not null || reserva.MinutosExcedidos is not null)
                                {
                                    <div class="mc-reservas__alertas">
                                        @if (reserva.MinutosDeRetraso is int retraso)
                                        {
                                            <span class="mc-badge mc-badge--warning">
                                                <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Sin llegar · @Duracion(retraso) de retraso
                                            </span>
                                        }
                                        @if (reserva.MinutosExcedidos is int exceso)
                                        {
                                            <span class="mc-badge mc-badge--danger">
                                                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Tiempo excedido · +@Duracion(exceso)
                                            </span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- Consumo (los montos van alineados a la derecha) -->
                            <td class="text-end mc-num">
                                @if (consumo is { Estado: "Abierta", Productos: > 0 })
                                {
                                    <span class="fw-medium">@MonteCarlo.WEB.Models.Catalogo.Colones.Formato(consumo.Total)</span>
                                    <span class="mc-reservas__sub">Cuenta abierta</span>
                                }
                                else if (consumo is { Estado: "Abandonada" })
                                {
                                    <span class="fw-medium">@MonteCarlo.WEB.Models.Catalogo.Colones.Formato(consumo.Total)</span>
                                    <span class="mc-reservas__sub text-danger"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Cerrada sin cobro</span>
                                }
                                else if (consumo is { Estado: "Cobrada", Total: > 0 })
                                {
                                    <span class="fw-medium">@MonteCarlo.WEB.Models.Catalogo.Colones.Formato(consumo.Total)</span>
                                    <a class="mc-reservas__sub" asp-controller="VentasListado" asp-action="Index"
                                       asp-route-FechaInicio="@reserva.FechaReserva.ToString("yyyy-MM-dd")"
                                       asp-route-FechaFin="@reserva.FechaReserva.ToString("yyyy-MM-dd")"
                                       aria-label="Ver @consumo.Folio en Ventas">@consumo.Folio</a>
                                }
                                else if (consumo is { Estado: "Cobrada" } || (reserva.Estado == "Finalizada" && consumo is null))
                                {
                                    <span class="text-secondary">Sin consumo</span>
                                }
                                else if (reserva.EnProgreso)
                                {
                                    <span class="text-secondary">Sin pedido</span>
                                }
                                else
                                {
                                    <span class="text-secondary" aria-label="Sin consumo">—</span>
                                }
                            </td>

                            <!-- Acciones en tres columnas fijas (principal, No Show, Cancelar) para que se alineen en todas las filas -->
                            <td>
                                <div class="mc-reservas__acciones">
                                    @if (reserva.EnProgreso)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary"
                                                data-mc-drawer data-mc-drawer-target="#mcCuentaDrawer"
                                                data-mc-drawer-url="@Url.Action("Cuenta", "Ventas", new { idReserva = reserva.IdReserva })">
                                            <i class="bi bi-receipt me-1" aria-hidden="true"></i>Cuenta
                                        </button>
                                    }
                                    else if (puedeLlegar)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal" data-bs-target="#modalAtender"
                                                data-codigo="@reserva.CodigoReserva" data-cliente="@nombre">
                                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Cliente llegó
                                        </button>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true"></span>
                                    }

                                    @if (puedeNoShow)
                                    {
                                        <button type="button" class="mc-icon-btn mc-icon-btn--danger"
                                                data-bs-toggle="modal" data-bs-target="#modalNoShow"
                                                data-codigo="@reserva.CodigoReserva" data-cliente="@nombre"
                                                aria-label="Marcar No Show a @nombre" title="Marcar No Show">
                                            <i class="bi bi-person-x" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true"></span>
                                    }

                                    @if (puedeCancelar)
                                    {
                                        <button type="button" class="mc-icon-btn mc-icon-btn--danger"
                                                data-bs-toggle="modal" data-bs-target="#modalCancelar"
                                                data-codigo="@reserva.CodigoReserva" data-cliente="@nombre"
                                                aria-label="Cancelar la reserva de @nombre" title="Cancelar reserva">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span aria-hidden="true"></span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Paginacion" model="@(new PaginacionViewModel
             {
                 Accion = "Index",
                 Controlador = "ReservasDelDia",
                 Pagina = Model.Pagina,
                 TotalPaginas = Model.TotalPaginas,
                 Total = Model.Filtradas.Count,
                 TamanoPagina = ReservasDelDiaViewModel.TamanoPagina,
                 Sustantivo = "reservas",
                 Parametros = parametros
             })" />
}

<!-- Modales de Confirmación -->
<div class="modal fade" id="modalAtender" tabindex="-1" aria-labelledby="modalAtenderTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAtenderTitulo">Cliente llegó</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Confirmar que el cliente <strong id="atenderNombre"></strong> llegó al restaurante? Ya podrás tomar su pedido.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>

                <form asp-action="atender" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" id="atenderCodigo" />
                    <input type="hidden" name="desde" value="@fechaDesde" />
                    <input type="hidden" name="hasta" value="@fechaHasta" />
                    <button type="submit" class="btn btn-primary">Sí, cliente llegó</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNoShow" tabindex="-1" aria-labelledby="modalNoShowTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNoShowTitulo">Marcar como No Show</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Confirmar que el cliente <strong id="noShowNombre"></strong> no se presentó?
                <span class="text-danger small mt-2 d-block">Esta acción liberará la mesa asignada.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>

                <form asp-action="noshow" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" id="noShowCodigo" />
                    <input type="hidden" name="desde" value="@fechaDesde" />
                    <input type="hidden" name="hasta" value="@fechaHasta" />
                    <button type="submit" class="btn btn-danger">Sí, marcar No Show</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cancelar reserva (HU-OPE-002) -->
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="modalCancelarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCancelarTitulo">Cancelar reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Cancelar la reserva de <strong id="cancelarNombre"></strong>?
                <span class="text-danger small mt-2 d-block">La mesa asignada quedará libre.</span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>

                <form asp-action="cambiar-estado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="codigo" id="cancelarCodigo" />
                    <input type="hidden" name="nuevoEstado" value="Cancelada" />
                    <input type="hidden" name="desde" value="@fechaDesde" />
                    <input type="hidden" name="hasta" value="@fechaHasta" />
                    <button type="submit" class="btn btn-danger">Sí, cancelar reserva</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Cajón de la cuenta (HU-CON-002): _Cuenta para tomar pedidos y cobrar. Su contenido llega por fetch. Las ventas cobradas se consultan en Ventas. -->
<div class="offcanvas offcanvas-end mc-drawer" tabindex="-1" id="mcCuentaDrawer" aria-labelledby="mcCuentaDrawerTitulo">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title fs-5" id="mcCuentaDrawerTitulo">Cuenta de la reserva</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body" data-mc-drawer-body></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Cada modal recibe la reserva del boton (o item del menu) que lo abrio.
            [['modalAtender', 'atenderCodigo', 'atenderNombre'],
             ['modalNoShow', 'noShowCodigo', 'noShowNombre'],
             ['modalCancelar', 'cancelarCodigo', 'cancelarNombre']].forEach(function (m) {
                document.getElementById(m[0]).addEventListener('show.bs.modal', function (event) {
                    var origen = event.relatedTarget;
                    document.getElementById(m[1]).value = origen.getAttribute('data-codigo');
                    document.getElementById(m[2]).textContent = origen.getAttribute('data-cliente');
                });
            });

            // Al cambiar una fecha, "Hasta" nunca queda antes de "Desde" (el formulario se envia solo).
            var filtros = document.getElementById('filtros-reservas');
            filtros.addEventListener('mc:autosubmit', function () {
                var desde = document.getElementById('desde'), hasta = document.getElementById('hasta');
                if (desde.value && (!hasta.value || hasta.value < desde.value)) hasta.value = desde.value;
            });

            // HU-CON-002: cualquier cambio en la cuenta actualiza la tabla al cerrar el cajón; al cobrar o liberar
            // se cierra solo y el aviso se muestra tras recargar.
            var cajon = document.getElementById('mcCuentaDrawer');
            var huboCambio = false;
            try {
                var pendiente = sessionStorage.getItem('mc.reservas.aviso');
                if (pendiente) { sessionStorage.removeItem('mc.reservas.aviso'); window.mc.avisar(pendiente, 5000); }
            } catch (e) { /* sin almacenamiento */ }
            // Direccion de la cuenta abierta en el cajon, para volver a pedirla cuando cambia.
            var urlCuenta = null;
            document.addEventListener('click', function (e) {
                var disparador = e.target.closest('[data-mc-drawer][data-mc-drawer-target="#mcCuentaDrawer"]');
                if (disparador) urlCuenta = disparador.getAttribute('data-mc-drawer-url');
            });
            function recargarCuenta() {
                if (!urlCuenta) return;
                fetch(urlCuenta, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.text(); })
                    .then(function (html) { cajon.querySelector('[data-mc-drawer-body]').innerHTML = html; });
            }
            document.addEventListener('mc:cuenta-cambio', function (e) {
                var d = e.detail || {};
                huboCambio = true;
                if (d.tipo === 'cobro' || d.tipo === 'sin-consumo' || d.tipo === 'sin-cobro') {
                    try { sessionStorage.setItem('mc.reservas.aviso', d.mensaje); } catch (err) { /* sin almacenamiento */ }
                    bootstrap.Offcanvas.getOrCreateInstance(cajon).hide();
                } else {
                    if (d.mensaje) window.mc.avisar(d.mensaje, 3000);
                    recargarCuenta();
                }
            });
            cajon.addEventListener('hidden.bs.offcanvas', function () {
                cajon.querySelector('[data-mc-drawer-body]').innerHTML = '';
                if (huboCambio) window.location.reload();
            });
        });
    </script>
}
