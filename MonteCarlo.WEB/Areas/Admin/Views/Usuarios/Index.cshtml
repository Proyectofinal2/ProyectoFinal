@*
    HU-AUT-006 — Listado de cuentas de administrador.

    Escenario 1  tabla con nombre, correo, rol y estado
    Escenario 2  desactivar, con confirmacion previa
    Escenario 3  reactivar
    Escenario 4  la cuenta propia se senala y no puede desactivarse
*@
@model CuentasIndexViewModel
@{
    ViewData["Title"] = "Cuentas de administrador";
    ViewData["Subtitle"] = "Controla quien tiene acceso al panel administrativo.";
}

@section PageActions {
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nueva cuenta
    </a>
}

@* Filtros. Van por GET para que un listado filtrado sea una URL
   compartible y el boton Atras se comporte como se espera. *@
<form asp-action="Index" method="get" class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label asp-for="Busqueda" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Busqueda" class="form-control"
                           placeholder="Nombre, usuario o correo" />
                </div>
            </div>

            <div class="col-md-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-select"
                        asp-items="Html.GetEnumSelectList<FiltroEstadoCuenta>()"></select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">Filtrar</button>
                @if (Model.TieneFiltrosAplicados)
                {
                    <a asp-action="Index" class="btn btn-link">Limpiar</a>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.Cuentas.Count == 0)
{
    @* Dos estados vacios distintos: si hay filtros el problema es la
       busqueda, y ofrecer "crear cuenta" seria desorientador. *@
    <div class="mc-table-card">
        @if (Model.TieneFiltrosAplicados)
        {
            <partial name="_EstadoVacio" model="EstadoVacioViewModel.SinResultados(Url.Action(nameof(Index)))" />
        }
        else
        {
            <partial name="_EstadoVacio" model="@(new EstadoVacioViewModel
                     {
                         Icono = "bi-people",
                         Titulo = "Aun no hay cuentas registradas",
                         Descripcion = "Crea la primera cuenta para dar acceso al panel administrativo.",
                         TextoAccion = "Nueva cuenta",
                         UrlAccion = Url.Action(nameof(UsuariosController.Crear))
                     })" />
        }
    </div>
}
else
{
    <div class="mc-table-card">
        <div class="table-responsive">
            <table class="table mc-table align-middle">
                <caption class="visually-hidden">
                    Cuentas de administrador con su rol y estado
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cuenta in Model.Cuentas)
                    {
                        <tr class="@(cuenta.EsCuentaPropia ? "mc-row-self" : null)">
                            <td>
                                <span class="fw-medium">@cuenta.NombreCompleto</span>
                                @if (cuenta.EsCuentaPropia)
                                {
                                    <span class="badge text-bg-light border ms-2">Tu cuenta</span>
                                }
                                <span class="d-block text-secondary small">@@@cuenta.NombreUsuario</span>
                            </td>

                            <td class="text-break">@cuenta.CorreoElectronico</td>

                            <td>@cuenta.RolLegible</td>

                            <td>
                                <partial name="_BadgeEstado" model="BadgeEstadoViewModel.Cuenta(cuenta.Activa)" />
                            </td>

                            <td class="text-end">
                                @if (cuenta.EsCuentaPropia)
                                {
                                    @* Escenario 4. El boton se deshabilita y se
                                       explica por que: un control apagado sin
                                       motivo se lee como un error del sistema.
                                       Va envuelto en un span porque un boton
                                       deshabilitado no dispara el tooltip. *@
                                    <span class="d-inline-block" tabindex="0"
                                          data-bs-toggle="tooltip"
                                          title="No puedes desactivar la cuenta con la que iniciaste sesion.">
                                        <button type="button" class="btn btn-sm btn-ghost-danger" disabled>
                                            Desactivar
                                        </button>
                                    </span>
                                }
                                else if (cuenta.Activa)
                                {
                                    <button type="button" class="btn btn-sm btn-ghost-danger"
                                            data-mc-confirm
                                            data-mc-confirm-title="Desactivar cuenta"
                                            data-mc-confirm-body="@($"{cuenta.NombreCompleto} dejara de poder iniciar sesion. La cuenta no se elimina y su historial se conserva.")"
                                            data-mc-confirm-action="@Url.Action(nameof(UsuariosController.Desactivar), new { id = cuenta.IdUsuario })"
                                            data-mc-confirm-label="Desactivar"
                                            data-mc-confirm-variant="danger">
                                        Desactivar
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-mc-confirm
                                            data-mc-confirm-title="Reactivar cuenta"
                                            data-mc-confirm-body="@($"{cuenta.NombreCompleto} volvera a poder iniciar sesion en el panel administrativo.")"
                                            data-mc-confirm-action="@Url.Action(nameof(UsuariosController.Reactivar), new { id = cuenta.IdUsuario })"
                                            data-mc-confirm-label="Reactivar"
                                            data-mc-confirm-variant="primary">
                                        Reactivar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="form-text mt-3">
        Mostrando @Model.Cuentas.Count @(Model.Cuentas.Count == 1 ? "cuenta" : "cuentas").
        Desactivar una cuenta no la elimina: su historial se conserva para auditoria.
    </p>
}

@section Scripts {
    <script>
        // Tooltip del boton deshabilitado en la fila de la cuenta propia.
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(function (el) { new bootstrap.Tooltip(el); });
    </script>
}
