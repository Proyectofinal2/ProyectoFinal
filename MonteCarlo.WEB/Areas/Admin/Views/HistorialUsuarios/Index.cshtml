@*
    HU-AUT-007 — Historial de cambios de cuentas de administrador (solo Administrador General).
    Quien, cuando y que cambio en cada cuenta (alta, edicion, habilitacion y deshabilitacion),
    del mas reciente al mas antiguo, paginado de 10 en 10. El historial no se puede editar ni eliminar.
*@
@using MonteCarlo.WEB.Models.Autenticacion
@using MonteCarlo.WEB.Models.UI
@model HistorialUsuariosViewModel
@{
    ViewData["Title"] = "Cuentas de administrador";
    ViewData["Subtitle"] = "Quién creó, editó, habilitó o deshabilitó cada cuenta.";
    var pagina = Model.Pagina;
}

@section PageActions {
    <span class="mc-badge mc-badge--info"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Solo Administrador General</span>
}

<partial name="_CuentasTabs" model='"historial"' />

@* Filtros por GET: cada pagina del historial es una URL compartible.
   Los selects filtran al cambiar; el buscador, con Enter. *@
<form asp-action="Index" method="get" role="search" class="mc-toolbar">
    <div class="mc-toolbar__fila">
        <div class="mc-search">
            <i class="bi bi-search mc-search__icono" aria-hidden="true"></i>
            <label for="busqueda" class="visually-hidden">Buscar cuenta</label>
            <input id="busqueda" name="busqueda" type="search" class="mc-search__input" value="@Model.Busqueda"
                   placeholder="Buscar nombre, usuario o correo de la cuenta" maxlength="100" autocomplete="off" />
        </div>

        <label for="idUsuario" class="visually-hidden">Realizado por</label>
        <select id="idUsuario" name="idUsuario" class="form-select mc-select" data-mc-autosubmit>
            <option value="">Realizado por: todos</option>
            @foreach (var responsable in Model.Responsables)
            {
                <option value="@responsable.IdUsuario" selected="@(Model.IdUsuario == responsable.IdUsuario)">@responsable.NombreCompleto</option>
            }
        </select>

        <label for="accion" class="visually-hidden">Acción</label>
        <select id="accion" name="accion" class="form-select mc-select" data-mc-autosubmit>
            <option value="">Todas las acciones</option>
            @foreach (var opcion in new[] { "Creada", "Editada", "Habilitada", "Deshabilitada" })
            {
                <option value="@opcion" selected="@(Model.Accion == opcion)">@opcion</option>
            }
        </select>

        @if (Model.TieneFiltros)
        {
            <a asp-action="Index" class="mc-toolbar__limpiar"><i class="bi bi-x-lg" aria-hidden="true"></i> Limpiar</a>
        }
    </div>
</form>

@if (pagina.Items.Count == 0)
{
    <div class="mc-table-card">
        @if (Model.TieneFiltros)
        {
            <partial name="_EstadoVacio" model="EstadoVacioViewModel.SinResultados(Url.Action(nameof(Index)))" />
        }
        else
        {
            <partial name="_EstadoVacio" model="@(new EstadoVacioViewModel
                     {
                         Icono = "bi-clock-history",
                         Titulo = "Aún no hay cambios registrados",
                         Descripcion = "Cuando se cree, edite, habilite o deshabilite una cuenta, aparecerá aquí con el administrador responsable."
                     })" />
        }
    </div>
}
else
{
    <div class="mc-table-card">
        <div class="table-responsive">
            <table class="table mc-table align-middle">
                <caption class="visually-hidden">Cambios en cuentas de administrador, del más reciente al más antiguo</caption>
                <thead>
                    <tr>
                        <th scope="col">Fecha</th>
                        <th scope="col">Realizado por</th>
                        <th scope="col">Cuenta</th>
                        <th scope="col">Cambio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cambio in pagina.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@cambio.Fecha.ToString("dd MMM yyyy, HH:mm", new System.Globalization.CultureInfo("es-CR"))</td>
                            <td>
                                <span class="fw-medium d-block">@cambio.Usuario</span>
                                <span class="small text-secondary">@cambio.RolLegible</span>
                            </td>
                            <td class="fw-medium">@cambio.NombreUsuarioAfectado</td>
                            <td class="mc-historial-cambio"><partial name="_CambioHistorialUsuario" model="cambio" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Paginacion" model="@(new PaginacionViewModel
             {
                 Accion = nameof(Index),
                 Controlador = "HistorialUsuarios",
                 Pagina = pagina.Pagina,
                 TotalPaginas = pagina.TotalPaginas,
                 Total = pagina.Total,
                 TamanoPagina = pagina.TamanoPagina,
                 Sustantivo = "cambios",
                 Parametros = new Dictionary<string, string?>
                 {
                     ["busqueda"] = Model.Busqueda,
                     ["idUsuario"] = Model.IdUsuario?.ToString(),
                     ["accion"] = Model.Accion
                 }
             })" />

    <p class="form-text mt-2">El historial no se puede editar ni eliminar.</p>
}
