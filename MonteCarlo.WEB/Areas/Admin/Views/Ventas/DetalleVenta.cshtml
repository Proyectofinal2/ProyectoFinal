@using MonteCarlo.WEB.Models.Catalogo
@using MonteCarlo.WEB.Models.UI
@using MonteCarlo.WEB.Models.Ventas
@model VentaDetalleApiResponse

<div class="row mb-4">
    <div class="col-sm-6">
        <p class="mb-1 text-muted small">Folio</p>
        <p class="fw-bold fs-5">@Model.Folio</p>

        <p class="mb-1 text-muted small">Fecha y Hora</p>
        <p>@Model.FechaVenta.ToString("dddd d 'de' MMMM 'de' yyyy, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))</p>
    </div>
    <div class="col-sm-6">
        <p class="mb-1 text-muted small">Atendido por</p>
        <p>@Model.UsuarioRegistro</p>

        <p class="mb-1 text-muted small">Origen / Pago / Estado</p>
        <p>
            @if (Model.TipoVenta == "Takeout")
            {
                <span class="mc-badge mc-badge--info"><i class="bi bi-bag me-1" aria-hidden="true"></i>Para llevar</span>
            }
            else
            {
                <span class="mc-badge mc-badge--neutral"><i class="bi bi-cup-hot me-1" aria-hidden="true"></i>En mesa</span>
            }
            <partial name="_MetodoPago" model="new MetodoPagoVisualViewModel(Model.MetodoPago, Model.MetodoPagoActivo ?? true)" />
            <partial name="_BadgeEstado" model="BadgeEstadoViewModel.Venta(Model.Estado)" />
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Motivo))
        {
            <p class="mb-1 text-muted small">Motivo</p>
            <p>@Model.Motivo</p>
        }
    </div>
</div>

<table class="table table-sm table-striped border">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-center">Cant.</th>
            <th class="text-end">Precio Unit.</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var linea in Model.Lineas)
        {
            <tr>
                <td>@linea.Producto</td>
                <td class="text-center">@linea.Cantidad</td>
                <td class="text-end">@Colones.Formato(linea.PrecioUnitario)</td>
                <td class="text-end fw-medium">@Colones.Formato(linea.Subtotal)</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end fw-bold border-0">Total:</td>
            <td class="text-end fw-bold fs-5 border-0">@Colones.Formato(Model.Total)</td>
        </tr>
    </tfoot>
</table>